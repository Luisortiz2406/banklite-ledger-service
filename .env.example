PORT=3006
DATABASE_URL=postgres://banklite:banklite@localhost:5432/ledger_db
JWT_SECRET=super-secreto-cambiar-en-produccion
ACCOUNT_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=reemplazar-por-clave-interna-compartida
RABBITMQ_URL=amqp://banklite:banklite@localhost:5672
