PORT=3006
# Secretos: genera cada uno con node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# El servicio no arranca si falta alguno, es corto o es un valor de ejemplo.
DATABASE_URL=postgres://ledger_svc:<DB_PASSWORD_LEDGER>@localhost:5432/ledger_db
JWT_SECRET=
STAFF_JWT_SECRET=
ACCOUNT_SERVICE_URL=http://localhost:3002
# Clave interna PROPIA de ledger-service (la acepta account-service).
INTERNAL_API_KEY=
# Quién puede mover dinero por /ledger/internal: transfer, card, payment, rewards, savings y deposit
# (deposit: recargas con Wompi; es el único que puede usar /ledger/internal/cash-ins).
# account: SOLO LECTURA (saldo de las cuentas canceladas); no puede mover dinero.
INTERNAL_TRUSTED_KEYS=transfer:<clave-de-transfer>,card:<clave-de-card>,payment:<clave-de-payment>,rewards:<clave-de-rewards>,savings:<clave-de-savings>,deposit:<clave-de-deposit>,account:<clave-de-account>
RABBITMQ_URL=amqp://banklite:<RABBITMQ_PASSWORD>@localhost:5672
RABBITMQ_EXCHANGE=banklite.events

# Consignación de prueba (POST /ledger/accounts/:id/deposits). Se rechaza SIEMPRE
# si NODE_ENV=production, aunque ENABLE_DEMO_DEPOSITS=true.
NODE_ENV=development
ENABLE_DEMO_DEPOSITS=true
DEMO_DEPOSIT_MAX_AMOUNT=5000000

# Opcionales (estos son los valores por defecto).
# Tope de un abono administrativo (POST /ledger/admin/credits).
ADMIN_CREDIT_MAX_AMOUNT=10000000
# Reintentos de las lecturas entre servicios (GET); las escrituras no se reintentan.
HTTP_READ_RETRIES=1
